{
  "name": "@dimo-network/data-sdk",
  "version": "1.6.0",
  "description": "DIMO Data SDK for JavaScript",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "author": "James Li",
  "contributors": [
    "Yusuf Çırak",
    "Eduardo Rodriguez",
    "Barrett Kowalsky"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "import": {
